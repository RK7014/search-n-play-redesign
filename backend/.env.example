# Copy this file to .env and adjust as needed. All variables are optional —
# the server runs with sensible defaults and an in-memory data store if
# nothing is set.

# development | production
APP_ENV=development

# Port the API server listens on.
PORT=8080

# PostgreSQL connection string. Leave unset to run with the built-in
# in-memory store (no database required) — the server logs a warning and
# keeps working; submitted data just won't survive a restart.
# Example: postgres://postgres:postgres@localhost:5432/searchnplay?sslmode=disable
DATABASE_URL=

# Comma-separated list of origins allowed to call the API directly from a
# browser (the Next.js dev server origin is included by default).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Token-bucket rate limit applied per client IP to public write endpoints
# (contact, newsletter, estimate).
RATE_LIMIT_RPS=2
RATE_LIMIT_BURST=10

# Maximum accepted request body size, in bytes.
MAX_REQUEST_BODY_BYTES=1048576
